// Prisma schema — Sistema PDV (Pedidos por QR Code, Mesa e Comanda)
//
// Banco atual: SQLite (arquivo local, zero configuração para desenvolver).
// Banco de produção: PostgreSQL (ver README > "Migrando para PostgreSQL").
//
// Regras seguidas para manter o schema portátil entre SQLite e PostgreSQL:
// - IDs são String @id @default(cuid()) (nunca autoincrement de inteiro,
//   que tem comportamento diferente entre os dois bancos).
// - Dinheiro é guardado em centavos (Int), nunca Float/Decimal — evita
//   problemas de precisão e diferenças de tipo Decimal entre bancos.
// - Enums são usados normalmente: o Prisma já emula enum no SQLite como
//   CHECK constraint e usa o tipo nativo no Postgres, então o schema não
//   muda ao migrar.
// - Não há nenhum recurso exclusivo de um provider (sem `@db.*` nativos).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// Restaurante — a raiz do isolamento multi-tenant. Toda tabela "de dados"
// do sistema (mesas, comandas, cardápio, pedidos, cupons, log...) carrega
// um `restaurantId` e é sempre consultada filtrando por ele. `slug` é o
// identificador usado nas duas telas públicas que não chegam via QR Code
// (totem físico e /pedir remoto — ver src/app/totem/[slug],
// src/app/pedir/[slug]): não precisa em mais lugar nenhum, porque QR Codes
// de mesa/comanda (`qrToken`/`token`) e o id do Checkout já são únicos
// globalmente e resolvem o restaurante sozinhos a partir do registro
// encontrado.
// ---------------------------------------------------------------------------

model Restaurant {
  id        String   @id @default(cuid())
  slug      String   @unique
  createdAt DateTime @default(now())

  settings  Settings?
  users     User[]
  tables    RestaurantTable[]
  comandas  Comanda[]
  categories Category[]
  products  Product[]
  orders    Order[]
  payments  Payment[]
  helpCalls HelpCall[]
  auditLogs AuditLog[]
  coupons   Coupon[]
  checkouts Checkout[]
  ifoodIntegration       IfoodIntegration?
  mercadoPagoIntegration MercadoPagoIntegration?
  cashShifts             CashShift[]
  cashMovements          CashMovement[]
  insumos                Insumo[]
  insumoMovements        InsumoMovement[]

  @@map("restaurants")
}

// ---------------------------------------------------------------------------
// Configurações do restaurante — uma linha por Restaurant (a chave
// primária É o restaurantId, não um id próprio). Nome, logo e cor de marca
// se propagam pro sistema inteiro (nav, telas do cliente, QR Codes); o
// estilo do QR é usado só na geração/impressão.
// ---------------------------------------------------------------------------

model Settings {
  restaurantId   String     @id
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantName String  @default("Comandas")
  logoUrl        String?
  brandColorHex  String  @default("#c1401f")
  qrDotStyle     String  @default("square") // square | dots | rounded | classy
  qrLogoInCenter Boolean @default(false)

  // Taxa de serviço (os "10%" costumeiros) — desligada até o dono ativar.
  // Só afeta o fechamento no PDV; a conta que o cliente vê nunca soma isso
  // (decisão consciente, pra não criar ambiguidade sobre o que ele deve).
  serviceFeeEnabled Boolean @default(false)
  serviceFeePercent Int     @default(10)

  // Couvert — valor fixo por comanda (não percentual, diferente da taxa de
  // serviço), desligado até o dono ativar. Diferente da taxa de serviço,
  // o cliente VÊ o couvert na própria conta desde o início (é uma cobrança
  // conhecida, não gorjeta) — ver Comanda.couvertCents pro snapshot por
  // atendimento.
  couvertEnabled Boolean @default(false)
  couvertCents   Int     @default(0)

  // Totem de autoatendimento (balcão) — desligado até o dono ativar.
  kioskEnabled Boolean @default(false)

  // Delivery e retirada agendada — canais remotos (fora do salão), mesmo
  // padrão do totem: desligados até o dono ativar. Ambos usam a tela
  // pública /pedir (ver src/app/pedir).
  deliveryEnabled        Boolean @default(false)
  scheduledPickupEnabled Boolean @default(false)

  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ---------------------------------------------------------------------------
// Usuários / staff (Administração, PDV, Cozinha)
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  WAITER // Operador de PDV / garçom
  KITCHEN // Cozinha (KDS)
}

model User {
  id           String   @id @default(cuid())
  // Global, não composto por restaurante — um e-mail é uma conta em todo o
  // sistema (decisão consciente: mantém o /login simples, sem precisar
  // saber a qual restaurante a pessoa pertence antes de digitar a senha).
  // Efeito colateral aceito: a mesma pessoa não pode ter contas de staff
  // em dois restaurantes diferentes com o mesmo e-mail.
  email        String   @unique
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions   Session[]
  payments   Payment[]  @relation("PaymentRegisteredBy")
  auditLogs  AuditLog[]
  cashShiftsOpened  CashShift[]    @relation("CashShiftOpenedBy")
  cashShiftsClosed  CashShift[]    @relation("CashShiftClosedBy")
  cashMovements     CashMovement[] @relation("CashMovementRegisteredBy")
  insumoMovements   InsumoMovement[]

  @@index([restaurantId])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Mesa — QR Code = localização ("onde entregar")
// ---------------------------------------------------------------------------

enum TableStatus {
  FREE // Livre
  OCCUPIED // Ocupada
  AWAITING_PAYMENT // Aguardando pagamento
}

model RestaurantTable {
  id           String      @id @default(cuid())
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  // Único por restaurante, não globalmente — "Mesa 1" existe em cada
  // restaurante. `qrToken` continua único globalmente de propósito: é a
  // única informação que uma URL de QR Code anônima tem, e precisa
  // resolver sozinha a qual restaurante pertence (ver /m/[tableToken]).
  number    Int
  qrToken   String      @unique @default(cuid())
  status    TableStatus @default(FREE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  comandas  Comanda[]
  orders    Order[]
  helpCalls HelpCall[]

  @@unique([restaurantId, number])
  @@index([restaurantId])
  @@map("tables")
}

// ---------------------------------------------------------------------------
// Comanda — QR Code = identidade da conta ("quem paga")
// ---------------------------------------------------------------------------

enum ComandaStatus {
  OPEN
  AWAITING_PAYMENT
  CLOSED
}

model Comanda {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  // Único por restaurante — mesmo raciocínio de RestaurantTable.number.
  // `token` continua único globalmente: é o que uma URL de QR Code de
  // comanda anônima tem pra resolver sozinha o restaurante.
  number   Int
  token    String        @unique @default(cuid())
  status   ComandaStatus @default(OPEN)
  openedAt DateTime      @default(now())
  closedAt DateTime?

  // Mesa "atual" da comanda, para consulta rápida no PDV. É apenas uma
  // referência de conveniência — a fonte de verdade de onde cada pedido
  // foi entregue continua sendo Order.tableId.
  currentTableId String?
  currentTable   RestaurantTable? @relation(fields: [currentTableId], references: [id])

  // Cupom aplicado nesta rodada (desde o último `openedAt`) — o caixa digita
  // no fechamento (ver ComandaCard). couponCode é um snapshot (mostrado pro
  // cliente na conta). Zerado sempre que a comanda recicla (fecha e volta a
  // ficar OPEN pra outro cliente), igual orders/payments são escopados por
  // openedAt.
  couponId      String?
  coupon        Coupon? @relation(fields: [couponId], references: [id])
  couponCode    String?
  discountCents Int     @default(0)

  // Snapshot do couvert (Settings.couvertCents) desta rodada — gravado só
  // quando a comanda senta numa mesa pela primeira vez neste atendimento
  // (ver `if (!comanda.currentTableId)` em /api/public/orders), não na
  // criação do cartão em si (comanda recém-cadastrada, parada numa
  // gaveta, não deve nada a ninguém ainda) nem em canais sem mesa física
  // (totem/entrega/agendado usam Checkout, não Comanda). Zerado junto com
  // discountCents sempre que a comanda recicla.
  couvertCents Int @default(0)

  orders    Order[]
  payments  Payment[]
  helpCalls HelpCall[]

  @@unique([restaurantId, number])
  @@index([restaurantId])
  @@map("comandas")
}

// ---------------------------------------------------------------------------
// Cardápio
// ---------------------------------------------------------------------------

model Category {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name      String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([restaurantId])
  @@map("categories")
}

model Product {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId  String
  name        String
  description String?
  priceCents  Int
  image       String?
  active      Boolean  @default(true)
  // Diferente de `active` (gestão permanente do cardápio, só em
  // Administração): `soldOut` é o "86" do dia a dia — faltou o insumo no
  // meio do serviço, a equipe marca rápido pelo PDV e desmarca quando
  // reabastecer. O produto continua cadastrado e ativo o tempo todo.
  soldOut     Boolean  @default(false)
  // true só quando foi o CONTROLE DE ESTOQUE que marcou soldOut=true
  // sozinho (insumo da receita zerou — ver src/lib/insumos.ts), nunca
  // quando a equipe marcou manualmente. Distinção importa nos dois
  // sentidos: reabastecer o insumo só desmarca automaticamente o que foi
  // marcado automaticamente (um "esgotado" manual por outro motivo não
  // pode voltar sozinho); e marcar/desmarcar manualmente pelo PDV sempre
  // zera essa flag, porque virou uma decisão humana a partir daí.
  soldOutAuto Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Cache do upload de imagem pro catálogo do iFood (ver
  // src/lib/ifood/catalog.ts) — evita baixar e reenviar a mesma imagem
  // em toda sincronização. `ifoodImageSourceUrl` guarda qual valor de
  // `image` gerou o path: se `image` mudar, o cache fica inválido e a
  // imagem é reenviada na próxima sincronização.
  ifoodImagePath      String?
  ifoodImageSourceUrl String?

  category Category        @relation(fields: [categoryId], references: [id])
  options  ProductOption[]
  orderItems OrderItem[]
  insumos  ProductInsumo[]

  @@index([categoryId])
  @@index([restaurantId])
  @@map("products")
}

enum ProductOptionType {
  ADDITIONAL // Adicional (soma ao preço) — ex: + Bacon R$ 5,00
  REMOVABLE // Removível (não altera preço) — ex: sem cebola
}

model ProductOption {
  id         String            @id @default(cuid())
  productId  String
  name       String
  type       ProductOptionType
  priceCents Int               @default(0)
  active     Boolean           @default(true)
  sortOrder  Int               @default(0)

  product          Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItemOptions OrderItemOption[]

  @@index([productId])
  @@map("product_options")
}

// ---------------------------------------------------------------------------
// Contador utilitário — usado para gerar o número sequencial dos pedidos
// (#1041, #1042, ...) de forma atômica e portátil entre bancos.
// ---------------------------------------------------------------------------

model Counter {
  name  String @id
  value Int    @default(0)

  @@map("counters")
}

// ---------------------------------------------------------------------------
// Pedido — vínculo com Mesa (onde entregar) e Comanda (quem paga)
// ---------------------------------------------------------------------------

enum OrderStatus {
  NEW
  ACCEPTED
  PREPARING
  READY
  // Só usado por pedidos DELIVERY, entre READY e DELIVERED (ver
  // src/lib/statusLabels.ts — progressão de status é por canal). Os
  // demais canais vão de READY direto pra DELIVERED.
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum OrderChannel {
  DINE_IN   // mesa + comanda, fluxo original
  KIOSK     // totem de autoatendimento, retirada no balcão
  DELIVERY  // pedido remoto, entregue no endereço do cliente
  SCHEDULED // pedido remoto, retirada agendada no balcão
  IFOOD     // pedido feito no app do iFood — ver src/lib/ifood
}

model Order {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  // Número sequencial de exibição (#1042), único por restaurante — cada
  // um tem sua própria sequência (ver src/lib/orderNumber.ts), começando
  // em 1041 de novo. Gerado pela aplicação a partir do model Counter,
  // dentro de uma transação — não usamos autoincrement() do banco porque
  // SQLite só permite isso na chave primária, e queremos o mesmo
  // comportamento em PostgreSQL. Pedido de totem usa a MESMA sequência —
  // o número também funciona como a senha de retirada.
  number      Int
  channel     OrderChannel @default(DINE_IN)
  // Obrigatórios só quando channel = DINE_IN (pedido de totem/delivery/
  // agendado não tem mesa nem comanda física — ver Checkout). Validado na
  // aplicação, não no banco.
  tableId     String?
  comandaId   String?
  status      OrderStatus  @default(NEW)
  totalCents  Int          @default(0)
  // Desconto de cupom já embutido em totalCents — guardado à parte só pra
  // exibir/auditar quanto foi abatido. couponCode é um snapshot (o cupom
  // pode ser desativado depois sem apagar o histórico de quem usou).
  discountCents Int     @default(0)
  couponCode    String?
  // Só preenchidos pra channel = DELIVERY / SCHEDULED respectivamente —
  // denormalizados do Checkout na hora da confirmação, pra Cozinha/PDV
  // mostrarem sem precisar de join.
  deliveryAddress String?
  scheduledFor    DateTime?
  // Id do pedido numa plataforma externa (hoje: iFood) — nome genérico de
  // propósito, pra outro canal externo futuro reaproveitar o mesmo campo.
  // Único por restaurante: evita criar o mesmo pedido duas vezes se um
  // evento chegar repetido antes do acknowledgment (ver src/lib/ifood).
  externalId  String?
  note        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  table   RestaurantTable? @relation(fields: [tableId], references: [id])
  comanda Comanda?         @relation(fields: [comandaId], references: [id])
  items   OrderItem[]
  payments Payment[]
  checkout Checkout?
  insumoMovements InsumoMovement[]

  @@unique([restaurantId, number])
  @@unique([restaurantId, externalId])
  @@index([restaurantId])
  @@index([tableId])
  @@index([comandaId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  // Opcional: pedidos de canais externos sem catálogo sincronizado (hoje:
  // IFOOD) não referenciam um Product local — o nome/preço já vêm como
  // snapshot abaixo, sem precisar de FK pro cardápio interno. Todo outro
  // canal continua sempre preenchendo isso normalmente.
  productId      String?
  productName    String // snapshot do nome no momento do pedido
  quantity       Int
  unitPriceCents Int // snapshot do preço no momento do pedido
  subtotalCents  Int
  observation    String?

  order   Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?           @relation(fields: [productId], references: [id])
  options OrderItemOption[]

  @@index([orderId])
  @@map("order_items")
}

model OrderItemOption {
  id             String            @id @default(cuid())
  orderItemId    String
  optionId       String
  optionName     String // snapshot
  type           ProductOptionType // snapshot
  priceCents     Int               // snapshot

  orderItem OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  option    ProductOption @relation(fields: [optionId], references: [id])

  @@index([orderItemId])
  @@map("order_item_options")
}

// ---------------------------------------------------------------------------
// Pagamento — feito por comanda (fecha a conta daquela pessoa)
// ---------------------------------------------------------------------------

enum PaymentMethod {
  CASH
  CREDIT
  DEBIT
  PIX
  // Pago dentro do app do iFood — nunca escolhido manualmente por
  // ninguém (não aparece como opção no PDV/totem), só usado pelo
  // src/lib/ifood/poller.ts ao registrar o Payment de um pedido que já
  // chegou pago. Categoria própria nos relatórios, pra não misturar com
  // PIX de verdade cobrado no salão.
  IFOOD
}

model Payment {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  // Obrigatório só pra pagamento de comanda (fluxo de mesa). Pagamento de
  // totem quita um Order avulso direto (orderId), sem comanda nenhuma.
  comandaId   String?
  orderId     String?
  method      PaymentMethod
  amountCents Int
  // Parte do valor cobrado que é taxa de serviço, não consumo — registrada
  // só pra relatório/auditoria. Nunca entra na conta de saldo da comanda
  // (`amountCents` continua sendo só o que quita o consumo em si).
  serviceFeeCents Int @default(0)
  registeredById String?
  paidAt      DateTime      @default(now())
  // Marca o pagamento que quitou o saldo e fechou a comanda (para relatórios
  // de "comandas fechadas" — a comanda em si volta a ficar OPEN na hora,
  // pronta pra outro cliente, então seu status não serve mais como marcador
  // histórico de fechamento). Pagamento de totem nunca marca isso.
  closesComanda Boolean     @default(false)

  comanda    Comanda? @relation(fields: [comandaId], references: [id])
  order      Order?   @relation(fields: [orderId], references: [id])
  registeredBy User? @relation("PaymentRegisteredBy", fields: [registeredById], references: [id])

  @@index([restaurantId])
  @@index([comandaId])
  @@index([orderId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Controle de caixa — abertura/fechamento de turno, sangria/reforço e
// conferência de dinheiro. Não bloqueia pagamento (Payment continua
// funcionando igual, com ou sem turno aberto) — é controle por cima do
// fluxo já existente, não uma trava. Por isso não há FK em Payment
// nenhuma: o vínculo com o turno é por JANELA DE TEMPO (`paidAt` entre
// `openedAt` e `closedAt`/agora), mesmo padrão já usado pra vincular
// pedidos/pagamentos ao "round" atual de uma comanda via
// `comanda.openedAt` (ver src/lib/comandaRound.ts) — ver
// src/lib/cashShift.ts pra como isso é somado.
// ---------------------------------------------------------------------------

enum ShiftStatus {
  OPEN
  CLOSED
}

model CashShift {
  id           String      @id @default(cuid())
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  status       ShiftStatus @default(OPEN)

  openingCents Int
  openedById   String
  openedBy     User     @relation("CashShiftOpenedBy", fields: [openedById], references: [id])
  openedAt     DateTime @default(now())

  closedById String?
  closedBy   User?     @relation("CashShiftClosedBy", fields: [closedById], references: [id])
  closedAt   DateTime?
  // Contado na gaveta por quem fecha, e o esperado calculado no mesmo
  // instante (abertura + dinheiro recebido - sangrias + reforços) — os
  // dois ficam gravados aqui como um retrato histórico do fechamento,
  // não recalculados depois (senão um pagamento lançado com atraso
  // mudaria a conferência de um turno já fechado).
  countedCashCents  Int?
  expectedCashCents Int?
  notes             String?

  movements CashMovement[]

  @@index([restaurantId, status])
  @@map("cash_shifts")
}

enum CashMovementType {
  WITHDRAWAL // sangria — dinheiro saindo do caixa
  SUPPLY // reforço — dinheiro entrando fora de uma venda (ex: repor troco)
}

model CashMovement {
  id             String           @id @default(cuid())
  restaurantId   String
  restaurant     Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  shiftId        String
  shift          CashShift        @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  type           CashMovementType
  amountCents    Int
  reason         String?
  registeredById String
  registeredBy   User             @relation("CashMovementRegisteredBy", fields: [registeredById], references: [id])
  createdAt      DateTime         @default(now())

  @@index([shiftId])
  @@index([restaurantId])
  @@map("cash_movements")
}

// ---------------------------------------------------------------------------
// Chamado de ajuda — botão "Preciso de ajuda" na tela do cliente. Cobre as
// exceções do fluxo autônomo (dúvida, item errado, etc.) sem o cliente
// precisar se levantar. Aparece só no PDV (é quem circula pelo salão).
// ---------------------------------------------------------------------------

model HelpCall {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableId String
  table   RestaurantTable @relation(fields: [tableId], references: [id])

  comandaId String
  comanda   Comanda @relation(fields: [comandaId], references: [id])

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([restaurantId])
  @@index([resolvedAt])
  @@map("help_calls")
}

// ---------------------------------------------------------------------------
// Log de auditoria — quem cancelou um pedido, quem editou preço/produto,
// quem encerrou uma comanda com saldo em aberto, quem mudou o papel de um
// usuário, quem mexeu em Configurações. Só leitura pra ADMIN (/admin/log) —
// não existe edição/exclusão de log por design, é o registro que fica.
// ---------------------------------------------------------------------------

model AuditLog {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // Categoria curta e estável (ex: "order.cancel", "product.update") — pra
  // filtrar/agrupar. `summary` é a frase pronta pra tela, já em português.
  action     String
  entityType String
  entityId   String?
  summary    String
  // Detalhe extra por tipo de ação (ex: preço antigo/novo) — string livre,
  // não precisa de schema fixo pra cada tipo de evento.
  detail     String?

  createdAt DateTime @default(now())

  @@index([restaurantId])
  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Checkout — sessão de pagamento que existe ANTES do Order nascer, para
// qualquer canal remoto (totem, delivery, retirada agendada). O pedido só
// é criado quando o pagamento é confirmado (a cozinha nunca vê pedido não
// pago). Guardar isso à parte do carrinho no navegador é o que permite,
// mais pra frente, um provider de pagamento real confirmar via webhook
// mesmo que o cliente já tenha saído de perto (PIX costuma ser pago no
// celular da própria pessoa, não no aparelho do totem/computador).
//
// Renomeado de KioskCheckout (era exclusivo do totem) — ver
// src/app/api/pedir/checkout para delivery/agendado, que reaproveita este
// mesmo model em vez de duplicar a lógica de sessão de pagamento.
// ---------------------------------------------------------------------------

model Checkout {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  // Itens do carrinho serializados (JSON) — vira o Order só depois de
  // aprovado, então não tem FK pra produto/opção aqui.
  cartJson    String
  // Subtotal dos itens, sem desconto — amountCents (o que é cobrado de
  // verdade) já vem com o cupom aplicado.
  subtotalCents Int @default(0)
  amountCents Int

  // Só PIX/CREDIT/DEBIT fazem sentido nesses canais (sem gaveta de dinheiro).
  method PaymentMethod @default(PIX)

  channel OrderChannel @default(KIOSK)
  // Só preenchido quando channel = DELIVERY.
  deliveryAddress String?
  // Só preenchido quando channel = SCHEDULED — valor vem de uma das opções
  // de GET /api/pedir/slots, revalidado no servidor (não confia no horário
  // vindo do cliente).
  scheduledFor DateTime?

  status   String @default("pending") // pending | approved | declined | expired
  provider String @default("mock")
  // Id externo do gateway (pra correlacionar webhook, no futuro com um
  // provider de verdade) — o mock não usa.
  providerRef String?

  couponId      String?
  coupon        Coupon? @relation(fields: [couponId], references: [id])
  discountCents Int     @default(0)

  orderId String? @unique
  order   Order?  @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@map("checkouts")
}

enum CouponType {
  PERCENT // desconto em % do subtotal
  FIXED   // desconto em centavos, fixo
}

// Cupom de desconto — aplicável no totem, no PDV (mesa) e nos canais
// remotos (delivery/agendado), todos reaproveitando src/lib/coupons.ts.
// `usedCount` só incrementa quando o pedido é confirmado de verdade
// (pagamento aprovado nos canais remotos, fechamento no PDV), não na hora
// de digitar o código, pra não esgotar o limite de uso com carrinho
// abandonado.
model Coupon {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  // Único por restaurante — dois restaurantes podem ter, cada um, um
  // cupom "BEMVINDO10".
  code   String
  type   CouponType
  // PERCENT: 1–100. FIXED: centavos.
  value  Int
  active Boolean    @default(true)

  maxUses   Int? // null = sem limite
  usedCount Int  @default(0)
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checkouts Checkout[]
  comandas  Comanda[]

  @@unique([restaurantId, code])
  @@index([restaurantId])
  @@map("coupons")
}

// ---------------------------------------------------------------------------
// Integração com o iFood — recebe pedidos feitos no app do iFood direto na
// Cozinha, como mais um OrderChannel (ver enum acima). Uma linha por
// restaurante (1:1, igual Settings). Client secret e refresh token nunca
// ficam em texto puro — ver src/lib/crypto.ts. O access token em si NÃO
// fica persistido aqui: expira em horas, então é buscado sob demanda (a
// partir do refresh token) e guardado só em memória do processo
// (src/lib/ifood/auth.ts).
//
// App do iFood é do tipo "distribuído" (uma autorização por loja, feita
// pelo dono da loja no Portal do Parceiro) — não "centralizado"
// (client_credentials direto). Por isso o fluxo de conexão troca um
// authorizationCode por um par access/refresh token (grant
// authorization_code), e as renovações seguintes usam o refresh token
// (grant refresh_token). Ver src/lib/ifood/auth.ts.
// ---------------------------------------------------------------------------

model IfoodIntegration {
  restaurantId String     @id
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  clientId        String
  // AES-256-GCM (iv:tag:ciphertext) — ver src/lib/crypto.ts. Nunca
  // devolvido pro navegador depois de salvo, campo write-only na UI.
  clientSecretEnc String
  // Idem — obtido na troca do authorizationCode, usado pra renovar o
  // access token sem precisar repetir a autorização no Portal do Parceiro
  // a cada 6h. Pode ser rotacionado a cada renovação (ver auth.ts).
  refreshTokenEnc String?

  // Preenchidos depois de "Conectar" (busca a lista de merchants da conta
  // e o admin escolhe um, se houver mais de um). merchantName é um
  // snapshot só pra exibir na tela sem precisar rechamar a API.
  merchantId   String?
  merchantName String?

  // Liga/desliga o poller sem apagar a credencial salva.
  enabled Boolean @default(false)

  // Observabilidade simples pra tela de Configurações mostrar "última
  // sincronização" / erro mais recente, sem precisar de uma tabela de log
  // separada pra isso.
  lastPollAt       DateTime?
  lastErrorAt      DateTime?
  lastErrorMessage String?

  // Idem, mas pra sincronização do cardápio (push cardápio → iFood, ver
  // src/lib/ifood/catalog.ts) — é um processo separado do poller de
  // pedidos acima, disparado manualmente pelo Administrador.
  lastCatalogSyncAt    DateTime?
  lastCatalogSyncError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ifood_integrations")
}

// ---------------------------------------------------------------------------
// Integração com o Mercado Pago — PIX real no totem e no /pedir (ver
// src/lib/payments/). Cada restaurante conecta a PRÓPRIA conta via OAuth
// (fluxo padrão por redirecionamento, diferente do "device code" do
// iFood): o dinheiro cai direto pra conta dele, a plataforma nunca
// custodia nada — não tem split/comissão. `accessTokenEnc`/
// `refreshTokenEnc` são da conta do restaurante; o client_id/secret DA
// APLICAÇÃO (identifica a plataforma Comandas como um todo, não é por
// restaurante) fica só no .env, nunca no banco.
// ---------------------------------------------------------------------------

model MercadoPagoIntegration {
  restaurantId String     @id
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  // AES-256-GCM (iv:tag:ciphertext) — ver src/lib/crypto.ts. Colado
  // diretamente pelo Administrador (Suas integrações → Credenciais no
  // painel do Mercado Pago) — não é obtido via OAuth (o app do Comandas
  // não é registrado como "Plataforma" no Mercado Pago, então não expõe
  // Client ID/Secret; um Access Token colado direto, como o próprio
  // iFood também aceita como client secret, resolve sem precisar disso).
  // Esse token não expira num prazo fixo como um token OAuth — só muda
  // se o próprio restaurante regenerar no painel dele.
  accessTokenEnc String

  mpUserId String? // id da conta MP, confirmado via GET /users/me ao salvar
  nickname String? // snapshot do nome/e-mail da conta, pra tela sem rechamar a API

  // true quando a conta conectada é um "usuário de teste" do Mercado Pago
  // (sandbox) — detectado em GET /users/me (`tags` inclui "test_user" ou
  // `test_data.test_user === true`, ver verifyMercadoPagoAccessToken).
  // NÃO dá pra inferir isso pelo prefixo do token (usuário de teste tem
  // token no formato normal "APP_USR-...", só o token de "Credenciais de
  // teste" da própria aplicação usa o prefixo "TEST-") — por isso precisa
  // ficar salvo aqui, não recalculado na hora. Usado pra: (1) mostrar o
  // aviso "modo de teste" no Admin, (2) mercadoPagoProvider.ts escolher o
  // payer.email certo (sandbox exige terminar em "@testuser.com").
  isTest Boolean @default(false)

  // Liga/desliga sem apagar a credencial salva — enquanto desligado,
  // getPaymentProvider() cai pro mock mesmo com PIX escolhido.
  enabled Boolean @default(true)

  lastErrorAt      DateTime?
  lastErrorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("mercadopago_integrations")
}

// ---------------------------------------------------------------------------
// Controle de estoque de insumos — receita por produto (o quanto uma
// unidade vendida consome de cada insumo), com baixa automática na criação
// do pedido e "86" automático (soldOut) quando um insumo zera. Escopo desta
// primeira versão: só o produto BASE consome insumo (adicionais/opções
// continuam só somando preço, sem receita própria — pode evoluir depois se
// fizer falta) e pedidos do iFood não são cobertos (o item do iFood não
// referencia productId — catálogo sincronizado à parte, ver
// src/lib/ifood/catalog.ts — então simplesmente não bate com nenhuma
// receita, sem precisar de código especial pra isso).
// ---------------------------------------------------------------------------

model Insumo {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  // Texto livre (não enum) de propósito — restaurante usa unidades bem
  // diferentes (kg, L, un, pacote, dúzia...); a tela sugere as mais comuns
  // mas não trava. Só usado pra exibição/registro, nunca convertido.
  unit         String   @default("un")
  // Quantidade atual em estoque, na unidade acima. Float (não Int/cents
  // como dinheiro em outros models) porque quantidade de insumo é
  // inerentemente fracionária (2,5kg de tomate) — precisão de ponto
  // flutuante é suficiente aqui, diferente de dinheiro.
  currentQty Float   @default(0)
  // Abaixo disso, a tela de insumos destaca "estoque baixo" — só um alerta
  // visual, nunca bloqueia venda (só o auto-86 em zero/negativo faz isso).
  lowStockAt Float   @default(0)
  active     Boolean @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  products  ProductInsumo[]
  movements InsumoMovement[]

  @@index([restaurantId])
  @@map("insumos")
}

// Receita: quanto uma unidade vendida de um Product consome de um Insumo.
// Ex: "X-Burger" consome 0,15 (kg) de "Carne" + 1 (un) de "Pão".
model ProductInsumo {
  id         String @id @default(cuid())
  productId  String
  insumoId   String
  qtyPerUnit Float

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  insumo  Insumo  @relation(fields: [insumoId], references: [id], onDelete: Cascade)

  @@unique([productId, insumoId])
  @@index([insumoId])
  @@map("product_insumos")
}

enum InsumoMovementType {
  ENTRADA // compra/reposição — sempre soma
  AJUSTE  // correção manual (perda, quebra, contagem, estorno de cancelamento) — soma ou subtrai
  VENDA   // baixa automática por pedido — sempre subtrai
}

model InsumoMovement {
  id           String             @id @default(cuid())
  restaurantId String
  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  insumoId     String
  insumo       Insumo             @relation(fields: [insumoId], references: [id])
  type         InsumoMovementType
  // Sempre já com sinal (negativo em VENDA, positivo em ENTRADA, qualquer
  // sinal em AJUSTE) — soma direto em Insumo.currentQty, sem precisar
  // reconstituir a partir de before/after.
  delta   Float
  reason  String?
  // Nulo em VENDA (baixa automática, sem operador humano) — ver
  // logAction, mesmo padrão de "Sistema" no log de auditoria.
  userId  String?
  user    User?   @relation(fields: [userId], references: [id])
  // Nulo em ENTRADA/AJUSTE manual — só preenchido em VENDA (e no estorno
  // de AJUSTE que reverte uma VENDA cancelada), pra rastrear qual pedido
  // gerou aquela baixa.
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([restaurantId])
  @@index([insumoId])
  @@map("insumo_movements")
}
